{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=punchsync.db"
  },
  "Cache": {
    "Provider": "InMemory"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "punchsync",
    "Audience": "punchsync-app",
    "ExpiryMinutes": "15",
    "RefreshTokenDays": "7"
  },
  "Cors": {
    "Origins": []
  }
}
